= form_for @<%= resource_name %>, html: { class: "<%= resource_name %>" } do |f|
  <%- columns.each do |column| -%>
  .mb-3
    = f.label :<%= column.name %>, class: 'form-label'
    = f.<%= column.field_type %> :<%= column.name %>, class: 'form-control', required: true
    = f.error_span(:<%= column.name %>)
  <%- end -%>
  .mb-3
    = f.submit nil, class: 'btn btn-primary'
    = link_to t('.cancel', :default => t("helpers.links.cancel")), <%= controller_routing_path %>_path, :class => 'btn btn-secondary'
