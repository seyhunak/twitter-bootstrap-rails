<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%%= content_for?(:title) ? yield(:title) : "<%= app_name %>" %></title>
    <%%= csrf_meta_tags %>
<% if cdn? -%>

    <%= css_tag %>
<% else -%>

    <%%= stylesheet_link_tag <%= stylesheet_arguments %>, :media => "all" %>
<% end -%>
  </head>
  <body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="/"><%= app_name %></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item"><%%= link_to "Home", "/", :class => "nav-link" %></li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <%%= bootstrap_flash %>
      <%%= yield %>

      <footer class="mt-5 py-3 border-top">
        <p class="text-body-secondary">&copy; Company <%%= Time.current.year %></p>
      </footer>
    </div>

<% if cdn? -%>
<%= indent_tags(script_tags, "    ") %>
<% else -%>
    <%%= javascript_include_tag <%= javascript_arguments %> %>
<% end -%>
  </body>
</html>
