import { Controller } from "@hotwired/stimulus"
<% if import_bootstrap? -%>
import * as bootstrap from "bootstrap"
<% end -%>

// Generated by twitter-bootstrap-rails (rails g bootstrap:stimulus).
//
// Attach it once, to <body>: <body data-controller="bootstrap">
//
// Bootstrap's data attributes (data-bs-toggle="modal", "dropdown", "collapse")
// keep working on their own. Tooltips and popovers are opt-in, so this sets them
// up on every Turbo render and disposes of them afterwards. Before Turbo caches
// a page it also closes open modals, offcanvases and dropdowns, so going back
// doesn't restore a page with a backdrop stuck over it.
export default class extends Controller {
  connect() {
    this.beforeCache = this.beforeCache.bind(this)
    document.addEventListener("turbo:before-cache", this.beforeCache)
    this.setUp()
  }

  disconnect() {
    document.removeEventListener("turbo:before-cache", this.beforeCache)
    this.tearDown()
  }

  setUp() {
    const bs = this.bootstrap
    if (!bs) return

    this.element.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => bs.Tooltip.getOrCreateInstance(el))
    this.element.querySelectorAll('[data-bs-toggle="popover"]').forEach((el) => bs.Popover.getOrCreateInstance(el))
  }

  tearDown() {
    const bs = this.bootstrap
    if (!bs) return

    this.element.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((el) => bs.Tooltip.getInstance(el)?.dispose())
    this.element.querySelectorAll('[data-bs-toggle="popover"]').forEach((el) => bs.Popover.getInstance(el)?.dispose())
  }

  beforeCache() {
    const bs = this.bootstrap
    if (bs) {
      document.querySelectorAll(".modal.show").forEach((el) => bs.Modal.getInstance(el)?.dispose())
      document.querySelectorAll(".offcanvas.show").forEach((el) => bs.Offcanvas.getInstance(el)?.dispose())
      document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach((el) => bs.Dropdown.getInstance(el)?.hide())
    }
    this.tearDown()

    // dispose() skips the hide transition, so clear what it would have removed.
    document.querySelectorAll(".modal.show, .offcanvas.show").forEach((el) => el.classList.remove("show"))
    document.querySelectorAll(".modal-backdrop, .offcanvas-backdrop").forEach((el) => el.remove())
    document.body.classList.remove("modal-open")
    document.body.style.removeProperty("overflow")
    document.body.style.removeProperty("padding-right")
  }

  get bootstrap() {
<% if import_bootstrap? -%>
    return bootstrap
<% else -%>
    return window.bootstrap
<% end -%>
  }
}
