| `<%= old %>` | <%= replacement %> |
<% end -%>
<% legacy::CLASS_PATTERNS.each do |_pattern, _replacement, example| -%>
| <%= example.split(" become").first %> | <%= example.split(/ becomes? /).last %> |
<% end -%>
