<% if @__bs_breadcrumbs.present? %>
  <nav aria-label="breadcrumb"<% if divider %> style="--bs-breadcrumb-divider: '<%= divider %>';"<% end %>>
    <ol class="breadcrumb <%= options[:class] %>">
      <% @__bs_breadcrumbs[0..-2].each do |crumb| %>
        <li class="breadcrumb-item <%= options[:item_class] %>">
          <%= link_to crumb[:name], crumb[:url], crumb[:options] %>
        </li>
      <% end %>
      <li class="breadcrumb-item <%= options[:active_class] %>" aria-current="page">
        <%= @__bs_breadcrumbs.last[:name] %>
      </li>
    </ol>
  </nav>
<% end %>
